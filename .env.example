# Tally-like UI is intentionally disabled unless explicitly enabled.
NEXT_PUBLIC_ENABLE_TALLY_UI=false

# Display-only white-label domain copy. Used for admin form labels/placeholders,
# never for routing or API calls. Defaults: factory1.in in production builds,
# localhost otherwise.
NEXT_PUBLIC_FACTORY1_SHARED_DOMAIN=factory1.in
# Optional example domains shown as placeholders for SUBDOMAIN / CUSTOM_DOMAIN.
# Default subdomain example is derived from the shared domain.
# NEXT_PUBLIC_FACTORY1_SUBDOMAIN_EXAMPLE=your-brand.factory1.in
# NEXT_PUBLIC_FACTORY1_CUSTOM_DOMAIN_EXAMPLE=erp.your-company.com
