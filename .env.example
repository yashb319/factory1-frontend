# Tally-like UI is intentionally disabled unless explicitly enabled.
NEXT_PUBLIC_ENABLE_TALLY_UI=false

# Display-only white-label domain copy. Used for admin form labels/placeholders,
# never for routing or API calls. Defaults: factory1.in in production builds,
# localhost otherwise.
NEXT_PUBLIC_FACTORY1_SHARED_DOMAIN=factory1.in
# Optional example domains shown as placeholders for SUBDOMAIN / CUSTOM_DOMAIN.
# Default subdomain example is derived from the shared domain.
# NEXT_PUBLIC_FACTORY1_SUBDOMAIN_EXAMPLE=your-brand.factory1.in
# NEXT_PUBLIC_FACTORY1_CUSTOM_DOMAIN_EXAMPLE=erp.your-company.com

# First-tranche Partner SaaS administration; requires matching backend foundation.
# Build-time public flags/asset hosts are not secrets. All rollouts default off.
NEXT_PUBLIC_PARTNER_SAAS_V2_ENABLED=false
NEXT_PUBLIC_PARTNER_SAAS_ASSET_HOSTS=

# Opt in to explicit host classification BEFORE attaching any new product domains.
# Exact authorities only, no wildcards. Preserve known direct and legacy hosts here.
PARTNER_SAAS_HOST_BOUNDARY_ENABLED=false
PARTNER_SAAS_DIRECT_HOSTS=factory1.in,www.factory1.in,factory1-frontend.vercel.app,localhost:3000
PARTNER_SAAS_LEGACY_HOSTS=

# Public bootstrap still fails closed when this rollout/backend readiness is off.
# This foundation cannot provision routing/TLS or enable operational sign-in.
PARTNER_SAAS_STOREFRONT_ENABLED=false
PARTNER_SAAS_BACKEND_ORIGIN=
PARTNER_SAAS_EDGE_TOKEN=
PARTNER_SAAS_ASSET_HOSTS=

# Confidential Partner BFF OAuth client. Server-only credentials; never NEXT_PUBLIC.
PARTNER_SAAS_OAUTH_CLIENT_ID=
PARTNER_SAAS_OAUTH_CLIENT_SECRET=
# Separate 32-byte base64url key used to derive session-bound browser CSRF tokens.
PARTNER_SAAS_CSRF_SECRET=
